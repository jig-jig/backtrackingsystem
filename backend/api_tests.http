@baseUrl = http://localhost:5000/api

### 1. Test Registration (Create an Administrator Account)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "username": "admin_user",
    "password": "SecurePassword123",
    "role": "Administrator"
}

###

### 2. Test Login (Retrieve JWT Token)
# @name loginRequest
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "username": "admin_user",
    "password": "SecurePassword123"
}

###

### 3. Test Accessing a Protected Route
@authToken = {{loginRequest.response.body.token}}

GET {{baseUrl}}/admin-dashboard
Authorization: {{authToken}}

### 4. Create Baseline Ordinance (Ordinance 001)
# Make sure you are logged in so @authToken is populated from Step 2
POST {{baseUrl}}/ordinances
Authorization: {{authToken}}
Content-Type: application/json

{
    "ordinance_number": "ORD-2026-501",
    "title": "Speed Limit Ordinance",
    "date_enacted": "2026-08-11",
    "category_id": 2,
    "remarks": "Testing the system migration from static enums to customizable category indexes.",
    "nas_file_path": "\\\\NAS-SERVER\\Ordinances\\2026\\ORD-501.pdf"
}

###

### 5. Create Amending Ordinance (Ordinance 102 links to 101)
# Note: For "amends_ordinance_id", verify the primary key ID from Step 4.
# If your DB is fresh, it will likely be ID: 4 (since mock data took 1, 2, 3)
POST {{baseUrl}}/ordinances
Authorization: {{authToken}}
Content-Type: application/json

{
    "ordinance_number": "ORD-2026-502",
    "title": "Revised Speed Limit Ordinance of San Francisco",
    "date_enacted": "2026-12-23",
    "category_id": "3",
    "remarks": "Amends ORD-2026-501 to adjust speed limits.",
    "nas_file_path": "\\\\NAS-SERVER\\Ordinances\\2026\\ORD-502.pdf",
    "amends_ordinance_id": 17,
    "new_status_for_old": "Amended"
}


### 6. Fetch the Backtracking Lineage Timeline
# Replace the "4" below with the base ordinance ID you created in Step 4
GET {{baseUrl}}/ordinances/10/lineage
Authorization: {{authToken}}


### 7. Search Ordinances by Keyword (Matches "Speed")
GET {{baseUrl}}/ordinances?q=Speed
Authorization: {{authToken}}

###

### 8. Search Ordinances by Number Fragment (Matches "101")
GET {{baseUrl}}/ordinances?q=101
Authorization: {{authToken}}

###

### 9. Filter Ordinances by Category and Status Combined
GET {{baseUrl}}/ordinances?category_id=2 and Transport&status=Amended
Authorization: {{authToken}}

### 10. Get Page 1 (Limit 2 records)
GET {{baseUrl}}/ordinances?page=1&limit=2
Authorization: {{authToken}}

###

### 11. Get Page 2 (Limit 2 records - Next Page)
GET {{baseUrl}}/ordinances?page=2&limit=2
Authorization: {{authToken}}

### 12. Create Ordinance with Dynamic Category ID
# Assumes Category ID '2' matches 'Traffic and Transport' in your new database table setup
POST {{baseUrl}}/ordinances
Authorization: {{authToken}}
Content-Type: application/json

{
    "ordinance_number": "ORD-2026-501",
    "title": "Speed Limit Ordinance",
    "date_enacted": "2026-08-11",
    "category_id": 2,
    "remarks": "Testing the system migration from static enums to customizable category indexes.",
    "nas_file_path": "\\\\NAS-SERVER\\Ordinances\\2026\\ORD-501.pdf"
}